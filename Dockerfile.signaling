# Room service image. Built from the repo root because the service validates messages
# against the shared protocol schema in packages/protocol.
# Base images are pinned by digest (BUG-043): a moved tag can't change what ships. Bump the
# digest on purpose (security updates) with the tag kept for reading.
FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016

COPY --from=ghcr.io/astral-sh/uv:0.10.9@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1

WORKDIR /app/services/signaling
COPY services/signaling/pyproject.toml services/signaling/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY packages/protocol/schema /app/packages/protocol/schema
COPY services/signaling/app ./app

RUN useradd --system --no-create-home watchsync
USER watchsync

ENV ENVIRONMENT=production TRUST_PROXY=1
# One worker: rooms live in this process's memory (DEC-003).
# No access log and warning-level logs: WebSocket URLs carry room tokens (BUG-003). 16 KB frame cap: messages are tiny.
CMD ["sh", "-c", "exec .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-access-log --log-level warning --ws-max-size 16384"]
