{
  "name": "@watchsync/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "zip": "WATCHSYNC_API=${WATCHSYNC_API:-https://join.watchsync.space} node build.mjs --zip",
    "zip:dev": "WATCHSYNC_CHANNEL=dev node build.mjs --zip",
    "e2e": "WATCHSYNC_MOCK=1 node build.mjs && PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.browsers\" playwright test",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.browsers\" playwright install chromium"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@watchsync/protocol": "workspace:^",
    "@watchsync/sync-engine": "workspace:^",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.3"
  }
}
