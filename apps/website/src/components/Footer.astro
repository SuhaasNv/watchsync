---
import { CONTACT_EMAIL, NOT_AFFILIATED, REPO_URL } from "../lib/site";
import Mark from "./Mark.astro";
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href="/">
          <Mark size={34} />
          <span class="sr-only">WatchSync home</span>
        </a>
        <p>
          A small browser extension that keeps your movie night in step. Made by Suhaas Nv. Say
          hello at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      </div>
      <nav aria-label="Footer">
        <ul>
          <li><a href="/features/">Features</a></li>
          <li><a href="/install/">Install</a></li>
          <li><a href="/releases/">Release notes</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href={REPO_URL} rel="noopener">GitHub</a></li>
        </ul>
      </nav>
    </div>
    <p class="legal">
      {NOT_AFFILIATED}. Netflix, Prime Video and JioHotstar are trademarks of their owners and are
      named here only to say what WatchSync works with.
    </p>
  </div>
  <p class="giant" aria-hidden="true">Watch<span>Sync</span></p>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: clamp(36px, 10vw, 140px);
    padding-top: 56px;
    box-shadow: inset 0 1px 0 var(--line);
    overflow: hidden;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px 64px;
  }
  .about {
    max-width: 30rem;
    display: grid;
    gap: 18px;
    color: var(--text2);
  }
  .brand {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    align-items: center;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(140px, auto));
    gap: 4px 40px;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--text);
    text-decoration: none;
    font-weight: 550;
  }
  ul a:hover {
    text-decoration: underline;
    text-decoration-color: var(--acc);
  }
  .legal {
    margin-top: 40px;
    font-size: 0.875rem;
    color: var(--text3);
    max-width: 52rem;
  }
  .giant {
    margin: 24px 0 0;
    font-family: var(--display);
    font-size: clamp(5rem, 21vw, 22rem);
    font-weight: 700;
    font-variation-settings:
      "opsz" 144,
      "SOFT" 100;
    letter-spacing: -0.05em;
    line-height: 0.72;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(214, 236, 240, 0.16);
    user-select: none;
    translate: 0 8%;
  }
  .giant span {
    font-style: italic;
    font-weight: 400;
    font-variation-settings:
      "opsz" 144,
      "SOFT" 100,
      "WONK" 1;
    -webkit-text-stroke-color: rgba(255, 210, 90, 0.4);
  }
</style>
