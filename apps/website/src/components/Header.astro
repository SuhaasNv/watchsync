---
import { NAV } from "../lib/site";
import DownloadButton from "./DownloadButton.astro";
import Mark from "./Mark.astro";

const path = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <Mark size={30} />
      <span class="word">WatchSync</span>
      <span class="sr-only">, home</span>
    </a>

    <nav aria-label="Main">
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-button
      >
        <span class="menu-icon" aria-hidden="true"></span>
        <span>Menu</span>
      </button>
      <ul id="site-menu" class="links" data-menu>
        {
          NAV.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <DownloadButton size="compact" class="head-cta" />
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  if (button && menu) {
    const set = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("open", open);
    };
    button.addEventListener("click", () => set(button.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("open")) {
        set(false);
        button.focus();
      }
    });
    // Close when focus or a click leaves the menu, so it never hides the page behind it.
    document.addEventListener("click", (e) => {
      if (e.target instanceof Node && !menu.contains(e.target) && !button.contains(e.target)) {
        set(false);
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(12, 18, 21, 0.78);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    min-height: 44px;
  }
  .word {
    font-family: var(--display);
    font-size: 1.4rem;
    font-weight: 620;
    font-variation-settings:
      "opsz" 48,
      "SOFT" 100;
    letter-spacing: -0.02em;
  }
  nav {
    margin-left: auto;
  }
  .links {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 10px;
    color: var(--text2);
    font-weight: 550;
    font-size: 0.97rem;
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .links a:hover {
    color: var(--text);
    background: rgba(214, 236, 240, 0.06);
  }
  .links a[aria-current="page"] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--acc);
    border-radius: 10px 10px 2px 2px;
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 820px) {
    .bar {
      gap: 8px;
    }
    nav {
      order: 3;
      margin-left: 0;
    }
    .head-cta {
      margin-left: auto;
    }
    .menu-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 0 12px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: var(--text);
      font: inherit;
      font-weight: 600;
      cursor: pointer;
    }
    .menu-icon {
      position: relative;
      width: 18px;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
      box-shadow:
        0 -6px 0 currentColor,
        0 6px 0 currentColor;
    }
    .links {
      display: none;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 20px;
      background: var(--bg);
      box-shadow:
        inset 0 -1px 0 var(--line),
        0 30px 40px -20px rgba(0, 0, 0, 0.6);
    }
    .links.open {
      display: flex;
    }
    .links a {
      width: 100%;
      min-height: 52px;
      font-family: var(--display);
      font-size: 1.6rem;
      font-weight: 500;
      color: var(--text);
      padding: 0;
      border-radius: 0;
      box-shadow: inset 0 -1px 0 var(--line);
    }
    .links a[aria-current="page"] {
      color: var(--acc);
      box-shadow: inset 0 -1px 0 var(--line);
      border-radius: 0;
    }
  }
  @media (max-width: 420px) {
    .word {
      font-size: 1.2rem;
    }
    .menu-btn span:last-child {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
