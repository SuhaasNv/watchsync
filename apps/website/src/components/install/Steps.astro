---
import { DOWNLOAD_URL } from "../../lib/site";
import Mark from "../Mark.astro";

interface Props {
  browser: "chrome" | "brave";
}
const { browser } = Astro.props;
const name = browser === "chrome" ? "Chrome" : "Brave";
const address = `${browser}://extensions`;
---

<ol class="steps">
  <li class="step">
    <div class="text">
      <span class="n" aria-hidden="true">1</span>
      <h3>Download the zip</h3>
      <p>
        Your browser saves <code>watchsync-extension.zip</code>, usually in your Downloads folder.
        Downloads come from our public GitHub.
      </p>
      <p>
        <a class="btn primary small" href={DOWNLOAD_URL}>Download WatchSync</a>
      </p>
    </div>
    <div class="art" aria-hidden="true">
      <div class="file">
        <span class="zip">ZIP</span>
        <span class="fname">watchsync-extension.zip</span>
        <span class="done">Done</span>
      </div>
    </div>
  </li>

  <li class="step">
    <div class="text">
      <span class="n" aria-hidden="true">2</span>
      <h3>Unzip it, and keep the folder</h3>
      <p>{name} can't load a zipped folder, so unzip it first:</p>
      <ul class="os">
        <li><strong>Windows:</strong> right-click the zip, choose Extract All, then Extract.</li>
        <li><strong>Mac:</strong> double-click the zip.</li>
        <li><strong>Linux:</strong> right-click the zip and choose Extract Here.</li>
      </ul>
      <p>
        Move the new <code>watchsync-extension</code> folder somewhere it can stay, like Documents. {name} loads WatchSync from that folder every time, so don't delete it.
      </p>
    </div>
    <div class="art" aria-hidden="true">
      <div class="finder">
        <p class="crumb">Documents <span>›</span> watchsync-extension</p>
        <ul>
          <li class="hl"><span class="doc"></span>manifest.json</li>
          <li><span class="dir"></span>icons</li>
          <li><span class="doc"></span>background.js</li>
          <li><span class="doc"></span>popup.html</li>
        </ul>
      </div>
    </div>
  </li>

  <li class="step">
    <div class="text">
      <span class="n" aria-hidden="true">3</span>
      <h3>Open the extensions page</h3>
      <p>
        Websites aren't allowed to link to this page, so copy the address, paste it into {name}'s
        address bar and press Enter.
      </p>
      <div class="copy-row">
        <code class="addr">{address}</code>
        <button class="btn small copy" type="button" data-copy={address}>
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>
    <div class="art" aria-hidden="true">
      <div class="browser">
        <div class="urlbar"><span class="lock"></span>{address}</div>
      </div>
    </div>
  </li>

  <li class="step">
    <div class="text">
      <span class="n" aria-hidden="true">4</span>
      <h3>Turn on Developer mode</h3>
      <p>The switch is at the top right of the extensions page.</p>
    </div>
    <div class="art" aria-hidden="true">
      <div class="browser">
        <div class="ext-head">
          <span class="ext-title">Extensions</span>
          <span class="devmode">Developer mode <span class="switch on"></span></span>
        </div>
      </div>
    </div>
  </li>

  <li class="step">
    <div class="text">
      <span class="n" aria-hidden="true">5</span>
      <h3>Click Load unpacked</h3>
      <p>
        It appears at the top left once Developer mode is on. Choose the
        <code>watchsync-extension</code> folder, the one with <code>manifest.json</code> directly inside
        it, and press Select. WatchSync's card appears on the page.
      </p>
    </div>
    <div class="art" aria-hidden="true">
      <div class="browser">
        <div class="ext-buttons">
          <span class="pb hl">Load unpacked</span><span class="pb">Pack extension</span><span
            class="pb">Update</span
          >
        </div>
        <div class="card">
          <Mark size={24} />
          <span><strong>WatchSync</strong> 0.1.0</span>
          <span class="switch on"></span>
        </div>
      </div>
    </div>
  </li>

  <li class="step">
    <div class="text">
      <span class="n" aria-hidden="true">6</span>
      <h3>Pin WatchSync</h3>
      <p>
        Click the puzzle piece next to the address bar, then the pin beside WatchSync. Its icon
        stays in your toolbar from now on.
      </p>
    </div>
    <div class="art" aria-hidden="true">
      <div class="browser">
        <div class="toolbar">
          <span class="urlbar short"></span>
          <span class="puzzle hl">
            <svg viewBox="0 0 24 24" width="18" height="18"
              ><path
                d="M10 3.5a2 2 0 0 1 4 0V5h4v4h-1.5a2 2 0 0 0 0 4H18v5h-5v-1.5a2 2 0 0 0-4 0V18H5v-5h1.5a2 2 0 0 0 0-4H5V5h5V3.5Z"
                fill="currentColor"></path></svg
            >
          </span>
        </div>
        <div class="menu">
          <span class="menu-row"
            ><Mark size={20} /> WatchSync <span class="pin hl"
              ><svg viewBox="0 0 24 24" width="16" height="16"
                ><path
                  d="M15 3.5 20.5 9l-2 .7-3.6 3.6.4 4.2-1.3 1.3-3.6-3.6L5 20.6 3.4 19l5.4-5.4-3.6-3.6 1.3-1.3 4.2.4L14.3 5.5Z"
                  fill="currentColor"></path></svg
              ></span
            ></span
          >
        </div>
      </div>
    </div>
  </li>

  <li class="step">
    <div class="text">
      <span class="n" aria-hidden="true">7</span>
      <h3>Make or join a room</h3>
      <p>
        Click the WatchSync icon and type your name. Press Create a room and send the link, or paste
        a friend's code and press Join room. Then open the same title on your own account.
      </p>
    </div>
    <div class="art" aria-hidden="true">
      <div class="popup">
        <p class="ph"><Mark size={20} /> <strong>WatchSync</strong></p>
        <p class="pt">Watch together, in sync</p>
        <p class="pl">Your name</p>
        <p class="pi">Asha</p>
        <p class="pbtn">Create a room</p>
      </div>
    </div>
  </li>
</ol>

<style>
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px clamp(32px, 6vw, 88px);
    align-items: center;
    padding-block: clamp(32px, 5vw, 56px);
    box-shadow: inset 0 1px 0 var(--line);
  }
  .text {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .text p,
  .os {
    color: var(--text2);
  }
  .n {
    font-family: var(--display);
    font-size: 3.6rem;
    font-weight: 300;
    font-variation-settings:
      "opsz" 144,
      "SOFT" 100;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--acc);
  }
  h3 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 540;
    letter-spacing: -0.025em;
  }
  code {
    color: var(--text);
    background: var(--raised);
    padding: 0.1em 0.4em;
    border-radius: 6px;
    overflow-wrap: anywhere;
  }
  .os {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 1.2em;
  }
  .os strong {
    color: var(--text);
  }
  .btn.small {
    min-height: 44px;
    padding: 0 16px;
    font-size: 0.95rem;
  }
  .copy-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .addr {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 10px;
    font-size: 1.05rem;
    box-shadow: inset 0 0 0 1px var(--line2);
  }

  /* Illustrations: the browser's UI drawn in our own colours, simplified. */
  .art {
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: 20px;
    background:
      radial-gradient(70% 80% at 50% 110%, rgba(255, 210, 90, 0.08), transparent 70%),
      var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.92rem;
  }
  .hl {
    box-shadow:
      0 0 0 2px var(--acc),
      0 0 24px rgba(255, 210, 90, 0.35) !important;
  }
  .file {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(100%, 360px);
    padding: 14px;
    border-radius: 14px;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line2);
  }
  .zip {
    display: grid;
    place-items: center;
    width: 40px;
    height: 48px;
    border-radius: 6px;
    background: #ebe3d3;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
  }
  .fname {
    flex: 1;
    font-family: var(--mono);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .done {
    color: var(--pres);
    font-weight: 650;
    font-size: 0.85rem;
  }
  .finder {
    width: min(100%, 360px);
    border-radius: 14px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line2);
    overflow: hidden;
  }
  .crumb {
    padding: 10px 14px;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--text2);
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .crumb span {
    color: var(--text3);
  }
  .finder ul {
    margin: 0;
    padding: 8px;
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .finder li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 0.82rem;
  }
  .doc,
  .dir {
    width: 14px;
    height: 16px;
    border-radius: 2px;
    background: var(--text2);
  }
  .dir {
    height: 12px;
    background: var(--acc);
  }
  .browser {
    width: min(100%, 380px);
    border-radius: 14px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line2);
    padding: 12px;
    display: grid;
    gap: 12px;
  }
  .urlbar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 14px;
    border-radius: 99px;
    background: var(--raised);
    font-family: var(--mono);
    font-size: 0.85rem;
  }
  .lock {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--text2);
  }
  .urlbar.short {
    flex: 1;
  }
  .ext-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 6px;
  }
  .ext-title {
    font-weight: 700;
    font-size: 1rem;
  }
  .devmode {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 10px;
    font-size: 0.82rem;
    box-shadow:
      0 0 0 2px var(--acc),
      0 0 24px rgba(255, 210, 90, 0.35);
  }
  .switch {
    position: relative;
    width: 34px;
    height: 18px;
    border-radius: 99px;
    background: #5a6a6d;
    flex: none;
  }
  .switch.on {
    background: var(--pres);
  }
  .switch::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
  }
  .switch.on::after {
    left: 19px;
  }
  .ext-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pb {
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 650;
    box-shadow: inset 0 0 0 1px var(--line2);
  }
  .card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border-radius: 12px;
    background: var(--raised);
  }
  .card span:nth-child(2) {
    flex: 1;
    font-size: 0.85rem;
    color: var(--text2);
  }
  .card strong {
    color: var(--text);
  }
  .toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .puzzle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--text);
  }
  .menu {
    justify-self: end;
    width: 78%;
    padding: 8px;
    border-radius: 12px;
    background: var(--raised);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45);
  }
  .menu-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px;
    font-weight: 600;
  }
  .pin {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: auto;
    border-radius: 50%;
    color: var(--acc);
  }
  .popup {
    width: min(100%, 280px);
    padding: 14px;
    border-radius: 14px;
    background: var(--bg);
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.45),
      inset 0 0 0 1px var(--line2);
    display: grid;
    gap: 8px;
  }
  .ph {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 10px;
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .pt {
    font-weight: 650;
    font-size: 1.05rem;
    margin-top: 4px;
  }
  .pl {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text2);
  }
  .pi {
    height: 38px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 10px;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line2);
  }
  .pbtn {
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--acc);
    color: var(--on-acc);
    font-weight: 650;
  }
  @media (max-width: 820px) {
    .step {
      grid-template-columns: 1fr;
    }
    .art {
      min-height: 0;
    }
  }
</style>
