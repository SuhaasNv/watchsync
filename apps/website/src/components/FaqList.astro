---
import type { Faq } from "../lib/faq";

interface Props {
  items: Faq[];
  headingLevel?: 2 | 3;
}
const { items, headingLevel = 2 } = Astro.props;
const H = headingLevel === 2 ? "h2" : "h3";
---

<div class="faq">
  {
    items.map((f) => (
      <details id={f.id}>
        <summary>
          <H class="q">{f.q}</H>
          <span class="sign" aria-hidden="true" />
        </summary>
        <div class="a" set:html={f.a} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    box-shadow: inset 0 -1px 0 var(--line);
  }
  details {
    box-shadow: inset 0 1px 0 var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 72px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q {
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    font-variation-settings:
      "opsz" 48,
      "SOFT" 100;
  }
  .q {
    transition: color 0.15s;
  }
  @media (hover: hover) and (pointer: fine) {
    summary:hover .q {
      color: var(--acc);
    }
  }
  .sign {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line2);
    transition:
      background-color 0.2s,
      transform 0.15s var(--ease);
  }
  summary:active .sign {
    transform: scale(0.92);
  }
  .sign::before,
  .sign::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--text);
    transition:
      transform 0.25s var(--ease),
      background-color 0.2s;
  }
  .sign::after {
    transform: rotate(90deg);
  }
  details[open] .sign::after {
    transform: rotate(0deg);
  }
  details[open] .sign {
    background: var(--acc);
    box-shadow: none;
  }
  details[open] .sign::before,
  details[open] .sign::after {
    background: var(--on-acc);
  }
  /*
   * The answer slides open and closed where the browser supports ::details-content; elsewhere
   * the native instant toggle remains. Closing (0.18s) is quicker than opening (0.28s).
   */
  @supports selector(::details-content) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      height: 0;
      overflow: clip;
      opacity: 0;
      transition:
        height 0.18s ease-out,
        opacity 0.12s ease-out,
        content-visibility 0.18s allow-discrete;
    }
    details[open]::details-content {
      height: auto;
      opacity: 1;
      transition:
        height 0.28s var(--ease),
        opacity 0.22s ease-out 0.04s,
        content-visibility 0.28s allow-discrete;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    details::details-content,
    details[open]::details-content {
      transition: none;
    }
  }
  .a {
    padding-bottom: 24px;
    max-width: 44rem;
    color: var(--text2);
  }
  .a :global(p + p) {
    margin-top: 0.8em;
  }
  .a :global(a) {
    color: var(--text);
  }
  .a :global(code) {
    color: var(--text);
    background: var(--raised);
    padding: 0.1em 0.4em;
    border-radius: 6px;
  }
</style>
