---
import { CARS, H, RIDGES, W } from "../../lib/film";
// A miniature of the real chat panel (apps/extension/public/sidebar.css) beside a player,
// with one tap burst of reactions floating up. Plain HTML and CSS; the script only replays it.
const messages = [
  { who: "Sam", initial: "S", time: "42:10", text: "that twist", you: false },
  { who: "Maya", initial: "M", time: "42:31", text: "wait, go back a bit", you: false },
  { who: "You", initial: "Y", time: "42:36", text: "rewinding now", you: true },
] as const;
const reactions = ["❤️", "😂", "😭", "🔥", "😱", "👏"] as const;
// One burst of four taps on the fire reaction; only the first carries the sender's name.
const burst = [{ name: "Sam" }, { name: "" }, { name: "" }, { name: "" }] as const;
---

<section class="chat" aria-labelledby="chat-title" data-reveal data-chat-demo>
  <div class="wrap grid">
    <div class="copy">
      <h2 id="chat-title">Talk while you <span class="em">watch.</span></h2>
      <p class="lede">
        Chat sits next to the player. Each message shows the minute of the film it was sent at.
      </p>
    </div>

    <figure class="demo">
      <div class="stage" aria-hidden="true">
        <div class="player">
          <svg class="still" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="chat-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#1d4350"></stop>
                <stop offset="0.62" stop-color="#d27a5a"></stop>
                <stop offset="1" stop-color="#ffd08a"></stop>
              </linearGradient>
            </defs>
            <rect width={W} height={H} fill="url(#chat-sky)"></rect>
            <circle cx="212" cy="92" r="13" fill="#ffd25a"></circle>
            <path d={RIDGES.far} fill="#4b6168"></path>
            <path d={RIDGES.mid} fill="#2a3d44"></path>
            <g transform="translate(40 0)">
              <rect x="-6" y="135.4" width="170" height="1.2" fill="#0b1317"></rect>
              {
                CARS.map((x, i) => (
                  <g transform={`translate(${x} 124)`}>
                    <rect width="27" height="10" rx={i === 0 ? 3 : 1.5} fill="#0b1317"></rect>
                    {[4, 10, 16, 22].map((wx) => (
                      <rect x={wx - 1.5} y="3" width="3" height="3" rx="0.6" fill="#ffd25a"></rect>
                    ))}
                  </g>
                ))
              }
            </g>
            <path d={RIDGES.near} fill="#111c21"></path>
          </svg>
          <span class="tag">Demo</span>
          <ul class="float">
            {
              burst.map((b) => (
                <li class="fl">
                  <span class="e">🔥</span>
                  {b.name && <span class="who-chip">{b.name}</span>}
                </li>
              ))
            }
          </ul>
          <span class="bar"><span></span></span>
        </div>

        <div class="panel">
          <div class="head">
            <h3>Chat</h3>
            <p class="room"><span>Room</span><span class="code">XBLHRQ</span></p>
            <span class="faces">
              <span class="face a">S</span><span class="face b">M</span><span class="face c">Y</span>
            </span>
          </div>
          <div class="log">
            {
              messages.map((m) => (
                <div class:list={["group", { mine: m.you }]}>
                  <p class="who">
                    <span class:list={["mark", m.initial.toLowerCase()]}>{m.initial}</span>
                    <span class:list={["name", { you: m.you }]}>{m.who}</span>
                    <span class="time">{m.time}</span>
                  </p>
                  <p class="msg">{m.text}</p>
                </div>
              ))
            }
          </div>
          <div class="reacts">
            {reactions.map((r) => <span class:list={["react", { hit: r === "🔥" }]}>{r}</span>)}
          </div>
          <div class="composer">
            <span class="box">Message the room</span>
            <span class="send">
              Send
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M4.5 12h14M13 6.5l5.5 5.5-5.5 5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </div>
      </div>
      <figcaption>A demo, not a real room.</figcaption>
    </figure>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-chat-demo]");
  if (section) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const run = () => {
      if (reduce.matches) return;
      section.classList.remove("go");
      void section.offsetWidth; // restart the CSS animations
      section.classList.add("go");
    };
    section.addEventListener("reveal", run, { once: true });
  }
</script>

<style>
  .chat {
    padding-top: clamp(48px, 13vw, 200px);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  h2 {
    font-size: clamp(2.6rem, 6vw, 5rem);
    letter-spacing: -0.04em;
  }

  .demo {
    margin: 0;
  }
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 12px;
    padding: clamp(12px, 2vw, 20px);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  figcaption {
    margin-top: 14px;
    font-size: 0.9rem;
    color: var(--text2);
  }

  /* The player: a plain dark frame with a progress bar, like the one in the install art. */
  .player {
    position: relative;
    min-height: 260px;
    border-radius: 14px;
    background: #0c1b22;
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  /* The same stand-in film as the hero (a train at dusk), held still. */
  .still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tag {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--raised);
    color: var(--text2);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .bar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    height: 4px;
    border-radius: 4px;
    background: rgba(236, 242, 241, 0.25);
  }
  .bar span {
    display: block;
    width: 62%;
    height: 100%;
    border-radius: inherit;
    background: #ecf2f1;
  }

  /* Floating reactions. The still version (no JavaScript, or reduced motion) shows them
     where they would be mid-float. Transform and opacity only. */
  .float {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fl {
    position: absolute;
    left: var(--x);
    bottom: 48px;
    display: grid;
    justify-items: center;
    gap: 2px;
    transform: translateY(calc(var(--y) * 0.5)) rotate(var(--r));
    will-change: transform, opacity;
  }
  /* Where each one starts, how far it floats and when it leaves. */
  .fl:nth-child(1) {
    --x: 14%;
    --y: -96px;
    --d: 0s;
    --t: 1.8s;
    --r: -8deg;
  }
  .fl:nth-child(2) {
    --x: 48%;
    --y: -128px;
    --d: 0.12s;
    --t: 2.1s;
    --r: 6deg;
  }
  .fl:nth-child(3) {
    --x: 72%;
    --y: -70px;
    --d: 0.26s;
    --t: 1.6s;
    --r: -4deg;
  }
  .fl:nth-child(4) {
    --x: 30%;
    --y: -150px;
    --d: 0.4s;
    --t: 1.9s;
    --r: 9deg;
  }
  .e {
    font-size: 32px;
    line-height: 1;
  }
  .who-chip {
    padding: 1px 8px;
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 650;
  }
  /* The emoji fades; its name chip switches on and off, so no half-faded text is ever on screen. */
  @keyframes chat-rise {
    0% {
      transform: translateY(0) rotate(0deg) scale(0.7);
    }
    100% {
      transform: translateY(var(--y)) rotate(var(--r)) scale(1);
    }
  }
  @keyframes chat-fade {
    0% {
      opacity: 0;
    }
    14%,
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes chat-chip {
    0% {
      opacity: 0;
    }
    1%,
    80% {
      opacity: 1;
    }
    81%,
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .chat .e,
    :global(.js) .chat .who-chip {
      opacity: 0;
    }
    .chat.go .fl {
      animation: chat-rise var(--t) var(--d) cubic-bezier(0.2, 0.6, 0.3, 1) both;
    }
    .chat.go .e {
      animation: chat-fade var(--t) var(--d) linear both;
    }
    .chat.go .who-chip {
      animation: chat-chip var(--t) var(--d) linear both;
    }
    .chat.go .react.hit {
      animation: chat-tap 0.16s ease-out;
    }
  }
  @keyframes chat-tap {
    from {
      background: rgba(255, 210, 90, 0.08);
    }
  }

  /* The panel: values taken from the extension's sidebar.css. */
  .panel {
    display: flex;
    flex-direction: column;
    min-height: 260px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line2);
    font-size: 13px;
    line-height: 20px;
    overflow: hidden;
  }
  .head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 12px 0 16px;
    box-shadow: inset 0 -1px 0 rgba(214, 236, 240, 0.06);
  }
  .head h3 {
    margin: 0;
    font-family: var(--display);
    font-size: 15px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 0;
  }
  .room {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text3);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .code {
    color: var(--text2);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .faces {
    display: flex;
    padding-left: 6px;
  }
  .face,
  .mark {
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--on-acc);
    font-weight: 600;
    line-height: 1;
  }
  .face {
    width: 24px;
    height: 24px;
    margin-left: -6px;
    font-size: 11px;
    box-shadow: 0 0 0 2px var(--surface);
  }
  .mark {
    width: 20px;
    height: 20px;
    font-size: 11px;
  }
  .a,
  .s {
    background: #ffd25a;
  }
  .b,
  .m {
    background: #5ed8c3;
  }
  .c,
  .y {
    background: #ff9f4a;
  }
  .log {
    flex: 1;
    padding: 12px 8px;
  }
  .group {
    padding: 8px 12px;
    border-radius: 12px;
  }
  .group + .group {
    margin-top: 4px;
  }
  .group.mine {
    background: rgba(255, 210, 90, 0.08);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 20px;
    margin: 0;
  }
  .name {
    font-weight: 600;
  }
  .name.you {
    color: var(--acc);
  }
  .time {
    margin-left: -4px;
    color: var(--text3);
    font-family: var(--mono);
    font-size: 12px;
    line-height: 16px;
    font-variant-numeric: tabular-nums;
  }
  .msg {
    margin: 2px 0 0;
    padding-left: 28px;
    color: var(--text);
  }
  .reacts {
    display: flex;
    justify-content: space-between;
    gap: 4px;
    padding: 0 10px 8px;
  }
  .react {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding-top: 1px;
    border-radius: 12px;
    font-size: 20px;
    line-height: 1;
  }
  .composer {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 12px 16px 14px;
    box-shadow: inset 0 1px 0 rgba(214, 236, 240, 0.06);
  }
  .box {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--line2);
    border-radius: 12px;
    background: var(--raised);
    color: var(--text3);
  }
  .send {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 14px 0 12px;
    border-radius: 12px;
    background: var(--acc);
    color: var(--on-acc);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .stage {
      grid-template-columns: 1fr;
    }
    .player {
      min-height: 200px;
    }
  }
</style>
