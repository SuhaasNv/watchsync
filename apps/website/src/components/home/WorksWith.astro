---
import { NOT_AFFILIATED } from "../../lib/site";
---

<section class="works" aria-labelledby="works-title">
  <div class="wrap">
    <h2 id="works-title" class="kicker">Works with</h2>
    <ul class="services">
      <li><img src="/logos/netflix.svg" alt="" width="64" height="64" />Netflix</li>
      <li><img src="/logos/primevideo.svg" alt="" width="64" height="64" />Prime Video</li>
      <li><img src="/logos/jiohotstar.png" alt="" width="64" height="64" />JioHotstar</li>
    </ul>
    <p class="fine">
      In Chrome and Brave on a computer. Everyone needs their own account on the service.
      <span class="mark">{NOT_AFFILIATED}; their names and logos belong to their owners.</span>
    </p>
  </div>
</section>

<style>
  .works {
    margin-top: clamp(40px, 10vw, 140px);
    padding-block: clamp(36px, 5vw, 56px);
    box-shadow:
      inset 0 1px 0 var(--line),
      inset 0 -1px 0 var(--line);
  }
  .wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 20px 48px;
  }
  .kicker {
    font-family: var(--mono);
    font-weight: 500;
    font-variation-settings: normal;
    line-height: 1.4;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text2);
  }
  .services {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.7em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--display);
    font-size: clamp(2rem, 5.4vw, 4.6rem);
    font-weight: 400;
    font-style: italic;
    font-variation-settings:
      "opsz" 144,
      "SOFT" 100,
      "WONK" 1;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .services li {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
  }
  /* Each service's own icon, small and unaltered, beside its name (nominative use). */
  .services img {
    width: 0.62em;
    height: 0.62em;
    max-width: 48px;
    max-height: 48px;
    border-radius: 22%;
    flex: none;
  }
  .mark {
    display: block;
    margin-top: 6px;
    color: var(--text3);
    font-size: 0.85rem;
  }
  .fine {
    grid-column: 2;
    color: var(--text2);
    font-size: 0.95rem;
    max-width: 48rem;
  }
  @media (max-width: 720px) {
    .wrap {
      grid-template-columns: 1fr;
    }
    .services {
      flex-direction: column;
      font-size: clamp(2.6rem, 13vw, 3.6rem);
      line-height: 1;
    }
    .fine {
      grid-column: 1;
    }
  }
</style>
