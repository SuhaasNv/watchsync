---
import ChatDemo from "../components/home/ChatDemo.astro";
import FinalCta from "../components/home/FinalCta.astro";
import Flagship from "../components/home/Flagship.astro";
import Hero from "../components/home/Hero.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import WorksWith from "../components/home/WorksWith.astro";
import Base from "../layouts/Base.astro";
import { DOWNLOAD_URL } from "../lib/site";

const site = Astro.site ?? new URL("http://localhost:4321");
const app = {
  "@type": "SoftwareApplication",
  name: "WatchSync",
  applicationCategory: "EntertainmentApplication",
  applicationSubCategory: "Browser extension",
  operatingSystem: "Chrome, Brave",
  description:
    "A free browser extension that keeps friends' Netflix, Prime Video and JioHotstar tabs in sync, each on their own account.",
  url: site.href,
  image: new URL("/og.png", site).href,
  downloadUrl: DOWNLOAD_URL,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base
  title="WatchSync: watch Netflix, Prime Video and JioHotstar together, in sync"
  description="A free browser extension for movie nights apart. Press play and your friends' tabs play too, each on their own account. Works in Chrome and Brave."
  jsonLd={app}
>
  <Hero />
  <WorksWith />
  <HowItWorks />
  <Flagship />
  <ChatDemo />
  <section class="wrap more" aria-labelledby="more-title">
    <h2 id="more-title">Beyond play <span class="em">and pause.</span></h2>
    <p class="lede">
      Chat and reactions, a 3-2-1 start, quiet drift correction, next episodes together, and
      what WatchSync can and can't see.
    </p>
    <a class="btn ghost" href="/features/">See every feature</a>
  </section>
  <FinalCta />
</Base>

<style>
  .more {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-top: clamp(44px, 11vw, 160px);
  }
  .more h2 {
    font-size: clamp(2.6rem, 5.6vw, 4.6rem);
    letter-spacing: -0.04em;
  }
  .more .lede {
    max-width: 52ch;
  }
</style>
