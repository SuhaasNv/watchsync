---
import DownloadButton from "../components/DownloadButton.astro";
import Steps from "../components/install/Steps.astro";
import Trust from "../components/Trust.astro";
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL } from "../lib/site";

const tabs = [
  { id: "chrome", label: "Chrome" },
  { id: "brave", label: "Brave" },
] as const;
---

<Base
  title="Install WatchSync in Chrome or Brave · WatchSync"
  description="A step-by-step guide to installing the WatchSync extension in Chrome or Brave: download, unzip, turn on Developer mode, load it, pin it and make your first room."
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Install guide</p>
      <h1>Let's get you <span class="em">set up.</span></h1>
      <p class="lede">
        WatchSync isn't on the Chrome Web Store yet, so you load it into your browser yourself.
        It's seven steps, and you only do them once. You'll need a computer: WatchSync doesn't run
        on phones.
      </p>
      <div class="head-cta">
        <DownloadButton withVersion />
      </div>
    </header>

    <section class="guide" aria-labelledby="guide-title">
      <h2 id="guide-title" class="sr-only">Steps</h2>
      <div class="tabs-bar">
        <p class="pick" id="pick-label">Your browser</p>
        <div class="tabs" role="tablist" aria-labelledby="pick-label" data-tabs>
          {
            tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                data-tab={t.id}
              >
                {t.label}
              </button>
            ))
          }
        </div>
      </div>
      {
        tabs.map((t, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${t.id}`}
            aria-labelledby={`tab-${t.id}`}
            data-panel={t.id}
            hidden={i !== 0}
          >
            <Steps browser={t.id} />
          </div>
        ))
      }
    </section>

    <section class="help" aria-labelledby="help-title">
      <p class="eyebrow">If something looks wrong</p>
      <h2 id="help-title">Small hiccups, <span class="em">quick fixes.</span></h2>
      <div class="issues">
        <article>
          <h3>"Manifest file is missing or unreadable"</h3>
          <p>
            You picked the wrong folder. Choose the folder that directly contains{" "}
            <code>manifest.json</code>. If you see another <code>watchsync-extension</code> folder
            inside the one you picked, choose that inner one. If you picked the zip file, unzip it
            first.
          </p>
        </article>
        <article>
          <h3>A banner about developer-mode extensions</h3>
          <p>
            That's expected for an extension you loaded yourself. Close it. If you pressed Disable,
            turn WatchSync back on with its switch on the extensions page.
          </p>
        </article>
        <article>
          <h3>WatchSync vanished from the toolbar</h3>
          <p>
            You probably moved or deleted the folder. Put it back, or press Load unpacked again and
            choose it in its new place. Then pin it again.
          </p>
        </article>
        <article>
          <h3>Something else?</h3>
          <p>
            Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, or read the{" "}
            <a href="/faq/">FAQ</a>.
          </p>
        </article>
      </div>
    </section>

    <section class="update" id="updating" aria-labelledby="update-title">
      <p class="eyebrow">Updating</p>
      <h2 id="update-title">Getting a <span class="em">new version.</span></h2>
      <ol>
        <li>
          Download the new zip from this site or the <a href="/releases/">release notes</a> and unzip
          it.
        </li>
        <li>
          Replace everything inside your WatchSync folder with the new files. Keep the folder where
          it is.
        </li>
        <li>
          Open <code>chrome://extensions</code> (or <code>brave://extensions</code>) and press the
          reload arrow on the WatchSync card.
        </li>
      </ol>
    </section>

    <div class="trust-wrap">
      <Trust variant="panel" />
    </div>
  </div>
</Base>

<script>
  import { initCopyButtons } from "../scripts/copy";
  import { initTabs } from "../scripts/tabs";
  initTabs();
  initCopyButtons();
</script>

<style>
  /* Two sticky bars: keep focused elements clear of them (WCAG 2.4.11). */
  :global(html) {
    scroll-padding-top: 170px;
  }
  .head-cta {
    margin-top: 32px;
  }
  .guide {
    margin-top: clamp(24px, 4vw, 48px);
  }
  .tabs-bar {
    position: sticky;
    top: 68px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    background: rgba(12, 18, 21, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .pick {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text2);
  }
  .tabs {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line2);
  }
  [role="tab"] {
    min-height: 44px;
    min-width: 96px;
    padding: 0 18px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text2);
    font: inherit;
    font-weight: 650;
    cursor: pointer;
  }
  [role="tab"]:hover {
    color: var(--text);
  }
  [role="tab"][aria-selected="true"] {
    background: var(--acc);
    color: var(--on-acc);
  }
  .help,
  .update {
    padding-top: clamp(72px, 10vw, 140px);
  }
  .help h2,
  .update h2 {
    margin-top: 18px;
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    letter-spacing: -0.04em;
  }
  .issues {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(32px, 5vw, 72px);
    margin-top: 40px;
  }
  .issues article {
    padding-block: 24px;
    box-shadow: inset 0 1px 0 var(--line);
  }
  .issues h3 {
    font-family: var(--sans);
    font-size: 1.15rem;
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.3;
    margin-bottom: 8px;
  }
  .issues p {
    color: var(--text2);
  }
  .issues a,
  .update a {
    color: var(--text);
  }
  code {
    color: var(--text);
    background: var(--raised);
    padding: 0.1em 0.4em;
    border-radius: 6px;
    overflow-wrap: anywhere;
  }
  .update ol {
    display: grid;
    gap: 14px;
    max-width: 44rem;
    margin: 36px 0 0;
    padding-left: 1.4em;
    color: var(--text2);
    font-size: 1.1rem;
  }
  .update li::marker {
    color: var(--acc);
    font-family: var(--display);
    font-weight: 600;
  }
  .trust-wrap {
    margin-top: clamp(72px, 10vw, 140px);
  }
  @media (max-width: 760px) {
    .issues {
      grid-template-columns: 1fr;
    }
    /* On a phone-sized window two sticky bars take too much of the screen. */
    .tabs-bar {
      position: static;
    }
    .pick {
      display: none;
    }
  }
</style>
