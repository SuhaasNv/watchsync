# Serves the static website build (dist/ copied to /srv) on Railway. See Dockerfile.website.
{
	admin off
	auto_https off
	persist_config off
}

# On every response, the 404 page included.
(security) {
	header {
		# Inline styles are allowed because Astro inlines small stylesheets; scripts must be files.
		# connect-src: the downloads page reads the latest release from the GitHub API.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	import security
	try_files {path} {path}/index.html {path}.html
	file_server

	# Astro's hashed bundles never change under the same name; everything else is short-lived.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /_astro/*
	header @other Cache-Control "public, max-age=300, must-revalidate"

	handle_errors {
		import security
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		respond "{err.status_code} {err.status_text}"
	}
}
