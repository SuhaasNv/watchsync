# Room service (services/signaling). Copy to .env or set in Railway.
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8000
ROOM_IDLE_EXPIRY_SECONDS=900
MAX_PARTICIPANTS=8
CREATE_PER_MINUTE=10
JOIN_PER_MINUTE=30
MESSAGES_PER_10S=60
# Signs room tokens so rooms come back after a restart or deploy (DEC-031). Required in
# production: at least 32 bytes, e.g. `openssl rand -base64 48`, kept the same across deploys
# (a new one ends every open room). Unset in development: a random one per process.
ROOM_SIGNING_SECRET=
# How long after a restart people's tokens may bring their rooms back.
RESTORE_WINDOW_SECONDS=600
# PROTOCOL_SCHEMA defaults to packages/protocol/schema/protocol.schema.json

# Extension build (apps/extension). Read at build time; only public values belong here.
WATCHSYNC_API=http://localhost:8000
# WATCHSYNC_MOCK=1 adds the local mock player (tests only)
